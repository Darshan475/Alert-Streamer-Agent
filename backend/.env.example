# OpenRouter + Nemotron (default) — get key at https://openrouter.ai/keys
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-v1-your_key_here
LLM_MODEL=openai/gpt-4o-mini

# Auto-load agent-generated demo alerts when store is empty
SEED_DEMO_ALERTS=true

# ── Other providers (optional) ──
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...

ALERT_STREAMER_API_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,https://alert-streamer-frontend.vercel.app
