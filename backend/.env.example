# ── LLM Provider (free for testing — switch to nvidia later) ──
# Options: openrouter | groq | huggingface | nvidia | offline
LLM_PROVIDER=huggingface

# API key for the active provider
LLM_API_KEY=your_hf_token_here
# Or use Hugging Face convention:
# HF_TOKEN=hf_your_token_here

# Optional model override (Hugging Face uses model:provider suffix)
# LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct:fastest

# Hugging Face defaults (NVIDIA Nemotron on Inference Providers):
#   model → nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4:fastest
#   alt   → nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-BF16:fastest

# ── Switch to NVIDIA Nemotron later ──
# LLM_PROVIDER=nvidia
# LLM_API_KEY=your_nvidia_key_from_build.nvidia.com
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Legacy NVIDIA vars (used when LLM_PROVIDER=nvidia and LLM_API_KEY is empty)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Alert Streamer API security
ALERT_STREAMER_API_KEY=dev-secret-change-in-production
JWT_SECRET=change-me-to-a-long-random-string

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Optional Redis for dedup cache (falls back to in-memory)
REDIS_URL=

# Database
DATABASE_URL=sqlite+aiosqlite:///./alert_streamer.db
